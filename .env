# ============= 数据库配置 =============
# 默认使用 PostgreSQL fanpage 数据库，可按需覆盖
DATABASE_ENGINE=postgresql+psycopg
DATABASE_USER=wfnb
DATABASE_PASSWORD=dev_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fanpage

# 如果更习惯直接提供完整连接串，可填写下方 DATABASE_URL
# 优先级高于上方分段配置；例如：
# DATABASE_URL=postgresql+psycopg://wfnb:dev_password@localhost:5432/fanpage
DATABASE_URL=

# 阿里云 OSS 存储配置示例
# 复制此文件为 .env 并填入你的真实配置

# ============= 存储类型配置 =============
# 可选值: "minio", "r2", "oss", "local"
STORAGE_TYPE=oss

# ============= 阿里云 OSS 配置 =============
# OSS Endpoint（不包含 bucket 名称）
# 示例: oss-cn-hangzhou.aliyuncs.com, oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# OSS AccessKey（从 RAM 控制台获取）
OSS_ACCESS_KEY=your_access_key

# OSS SecretKey（从 RAM 控制台获取）
OSS_SECRET_KEY=your_secret_key

# OSS Bucket 名称
OSS_BUCKET=wangfeng-fan-website

# OSS 自定义域名（可选，如果配置了 CNAME）
# 如果不配置，将使用默认格式: bucket.endpoint
# OSS_CUSTOM_DOMAIN=img.yourdomian.com

# ============= JWT 配置 =============
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============= 邮件配置（可选） =============
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=25
SMTP_USERNAME=noreply@wfnb.cc
SMTP_PASSWORD=your_email_password
SENDER_EMAIL=noreply@wfnb.cc
SENDER_NAME=感受峰 感受存在
# ============= 应用配置 =============
DEBUG=False
BACKEND_PORT=1994
